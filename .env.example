# =============================================================================
# FinFuture Wealth Advisory System - Environment Configuration Template
# =============================================================================
# Copy this file to .env (repo root) and supply your credentials:
#   cp .env.example .env
# The backend reads ./.env and ../.env, so the root file works for both
# `uvicorn` run from backend/ and `docker compose up`.
# Every key is optional for a local run: without them the app uses SQLite, an in-memory
# cache, simulated paper fills and console OTP delivery.

# --- Application Metadata ---
APP_NAME="FinFuture Wealth Advisor"
APP_VERSION="2.0.0"
# production enables strict startup guards (unique 32+ char secrets, no DEBUG, no OTP_DEV_ECHO)
ENVIRONMENT="development"  # development | test | production
DEBUG=false
LOG_LEVEL="INFO"          # DEBUG | INFO | WARNING | ERROR

# --- Allowed CORS Origins ---
# Comma-separated list of origins allowed to call the backend, or '*' for open
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://finfuture.vercel.app"
# Optional: extra allowed origins as a regex (default: this project's Vercel domains + localhost)
# CORS_ORIGIN_REGEX="https://fin-?future(-[a-z0-9-]+)?\\.vercel\\.app|http://localhost:\\d+"

# --- Security & JWT Authentication ---
# Generate with: openssl rand -hex 32
# Required in production: at least 32 chars and different from AUDIT_SECRET_KEY (app refuses to start otherwise)
# SECRET_KEY="replace-with-openssl-rand-hex-32"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
# AUDIT_SECRET_KEY="replace-with-a-different-openssl-rand-hex-32"

# --- Sign-up / login abuse limits (per client IP; in-process, reset on restart) ---
AUTH_RATE_LIMIT_ENABLED=true
REGISTER_MAX_PER_IP_PER_HOUR=10
# Sepolia anchoring spends test ETH: per-client cooldown and server-wide hourly cap
ANCHOR_COOLDOWN_SECONDS=600
ANCHOR_MAX_PER_HOUR=20
LOGIN_FAILURES_MAX_PER_IP=30   # failed logins per IP per 15 minutes (each account also locks after 5)

# --- Database & Persistence ---
# PostgreSQL (Production):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/wealth_advisor
# SQLite (Development / Testing):
DATABASE_URL=sqlite+aiosqlite:///./wealth_advisor.db

# --- Cache & Distributed Locks ---
REDIS_URL=redis://localhost:6379/0

# --- Brokerage & Execution Safety Guard ---
# CRITICAL: ALPACA_PAPER must ALWAYS be true. Live execution is blocked by safety guards.
ALPACA_PAPER=true
ALPACA_BASE_URL="https://paper-api.alpaca.markets"
# ALPACA_API_KEY="your-alpaca-paper-api-key"
# ALPACA_SECRET_KEY="your-alpaca-paper-secret-key"

# --- Optional: anchor audit Merkle roots on Ethereum Sepolia (testnet) ---
# Needs all three of: an RPC URL (free from Infura or Alchemy), the private key of a wallet
# used ONLY for this testnet, and a little free Sepolia ETH in that wallet (from a faucet).
# Each anchor is a zero-value transaction whose input data is the Merkle root; look it up at
# https://sepolia.etherscan.io/tx/<tx_hash>. Mainnet (chain ID 1) is refused.
SEPOLIA_CHAIN_ID=11155111
# SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/your-infura-project-id"
# SEPOLIA_PRIVATE_KEY="0x..."     # testnet-only wallet; never reuse a real wallet
# AUDIT_CONTRACT_ADDRESS=""       # optional; default sends to the wallet itself

# --- LLM & Market Data Intelligence ---
# OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4o"
# FRED_API_KEY="your-fred-api-key"
# FMP_API_KEY="your-fmp-api-key"
# POLYGON_API_KEY="your-polygon-api-key"
# COINGECKO_API_KEY="your-coingecko-api-key"

# --- Step-Up OTP for trade approval (orders > $1,000 or > 5% of the portfolio) ---
# A random single-use 6-digit code is emailed to the account address. Configure ONE provider:
#   Brevo (HTTPS; a single verified sender address such as a Gmail account can mail anyone):
#     set BREVO_API_KEY and EMAIL_FROM to that verified address. Best choice on Render,
#     whose free tier blocks outbound SMTP.
#   Resend (HTTPS; needs a verified domain to mail addresses other than your own)
#   SMTP (e.g. Gmail with an App Password: https://myaccount.google.com/apppasswords)
# With none, development logs codes to the server console; production refuses to send.
OTP_DELIVERY="auto"            # auto | email | console
EMAIL_FROM="FinFuture <you@example.com>"
# BREVO_API_KEY=""
# RESEND_API_KEY=""
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USERNAME="you@gmail.com"
# SMTP_PASSWORD="your-16-char-app-password"
# SMTP_USE_SSL=false           # true for port 465
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
# Local demos only: show the code in the trade ticket when no email provider is set.
# Refused when ENVIRONMENT=production.
OTP_DEV_ECHO=false

# --- Execution Controls ---
DRY_RUN=false
