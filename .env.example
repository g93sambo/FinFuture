# =============================================================================
# FinFuture Wealth Advisory System - Environment Configuration Template
# =============================================================================
# Copy this file to .env and supply your credentials:
#   cp .env.example .env

# --- Application Metadata ---
APP_NAME="FinFuture Wealth Advisor"
APP_VERSION="2.0.0"
ENVIRONMENT="production"  # development | test | production
DEBUG=false
LOG_LEVEL="INFO"          # DEBUG | INFO | WARNING | ERROR

# --- Allowed CORS Origins ---
# Comma-separated list of origins allowed to call the backend, or '*' for open
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://finfuture.vercel.app"
# Optional: extra allowed origins as a regex (default: this project's Vercel domains + localhost)
# CORS_ORIGIN_REGEX="https://fin-?future(-[a-z0-9-]+)?\\.vercel\\.app|http://localhost:\\d+"

# --- Security & JWT Authentication ---
# Generate with: openssl rand -hex 32
# Required in production: at least 32 chars and different from AUDIT_SECRET_KEY (app refuses to start otherwise)
SECRET_KEY="replace-with-a-secure-random-32-byte-hex-string-for-jwt"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
AUDIT_SECRET_KEY="replace-with-a-secure-32-byte-secret-for-audit-log-hmac"

# --- Database & Persistence ---
# PostgreSQL (Production):
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/wealth_advisor
# SQLite (Development / Testing):
DATABASE_URL=sqlite+aiosqlite:///./wealth_advisor.db

# --- Cache & Distributed Locks ---
REDIS_URL=redis://localhost:6379/0

# --- Brokerage & Execution Safety Guard ---
# CRITICAL: ALPACA_PAPER must ALWAYS be true. Live execution is blocked by safety guards.
ALPACA_PAPER=true
ALPACA_BASE_URL="https://paper-api.alpaca.markets"
ALPACA_API_KEY="your-alpaca-paper-api-key"
ALPACA_SECRET_KEY="your-alpaca-paper-secret-key"

# --- Bamboo Brokerage (Nigerian & Cross-Border Wealth) ---
BAMBOO_LIVE_MODE=false
BAMBOO_BASE_URL="https://powered-by-bamboo-sandbox.investbamboo.com"
BAMBOO_APP_KEY="your-bamboo-sandbox-app-key"
BAMBOO_USERNAME="your-bamboo-tenant-username"
BAMBOO_PASSWORD="your-bamboo-tenant-password"

# --- Web3 & Sepolia Blockchain Anchoring Guard ---
# CRITICAL: Mainnet (Chain ID 1) is strictly forbidden. Sepolia is Chain ID 11155111.
SEPOLIA_CHAIN_ID=11155111
SEPOLIA_RPC_URL="https://sepolia.infura.io/v3/your-infura-project-id"
SEPOLIA_PRIVATE_KEY=""
AUDIT_CONTRACT_ADDRESS=""

# --- LLM & Market Data Intelligence ---
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4o"
FRED_API_KEY="your-fred-api-key"
FMP_API_KEY="your-fmp-api-key"
POLYGON_API_KEY="your-polygon-api-key"
COINGECKO_API_KEY="your-coingecko-api-key"

# --- Execution Controls ---
DRY_RUN=false
